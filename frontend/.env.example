# Uso local (AULA BOX): dejar vacio. El frontend llama a rutas relativas
# porque FastAPI sirve el build (frontend/dist) desde el mismo puerto.
# VITE_API_BASE_URL=

# Uso en desarrollo con `npm run dev` en un puerto distinto al backend:
# el proxy de vite.config.ts ya redirige /api al backend en 127.0.0.1:8000,
# no es necesario definir esta variable.

# Uso en el demo publico (Vercel): URL completa del backend desplegado en Render.
# VITE_API_BASE_URL=https://aula-raiz-backend.onrender.com

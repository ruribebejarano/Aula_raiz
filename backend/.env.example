# Modo del motor de IA: "demo" (siempre disponible, sin internet), "ollama"
# (modelo local opcional) o "claude" (API de Anthropic, solo para presentaciones
# en vivo — no es requisito del MVP offline).
AI_PROVIDER=demo

# Solo se usan si AI_PROVIDER=ollama. Ollama debe correr en la misma red local.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Solo se usan si AI_PROVIDER=claude. Genera tu propia clave en
# https://console.anthropic.com — NUNCA la subas al repositorio ni la pongas
# en el frontend. Sin esta clave, AI_PROVIDER=claude cae automaticamente a demo.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Nombre de la escuela mostrado en el dashboard (solo demostrativo)
SCHOOL_NAME=I.E. Rural Huarin (demo)

# Orígenes permitidos para CORS, separados por coma. Agrega la IP LAN de AULA BOX
# que usará el celular del docente, por ejemplo http://192.168.1.20:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
